rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isCustoms() {
      return isSignedIn() && userRole() == 'customs';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Self-service signup only ever creates a trader account; customs
      // officer accounts are provisioned directly in the Firebase Console,
      // never through this rule, so client code can never grant itself
      // customs access by writing its own user document.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'trader';

      // A user can update their own profile, but role is immutable once
      // set — otherwise a trader could self-escalate to customs by
      // writing their own user document directly via the SDK.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Consignments are created by traders and reviewed by customs
    // officers. A trader may only read/update their own; customs officers
    // (role looked up from their own user document) can act on all of
    // them, since reviewing consignments they don't own is the point of
    // the role.
    match /consignments/{consignmentId} {
      function isOwnTrader() {
        return resource.data.traderId == request.auth.uid
          // Consignments created before `traderId` was recorded fall back
          // to matching the trader's verified auth email.
          || (!('traderId' in resource.data) && resource.data.traderEmail == request.auth.token.email);
      }

      allow read: if isSignedIn() && (isOwnTrader() || isCustoms());

      allow create: if isSignedIn()
        && request.resource.data.traderId == request.auth.uid
        && request.resource.data.status == 'Pending';

      // Traders can update their own consignment (e.g. uploading documents)
      // but can never change its review status themselves — only customs
      // officers can approve/reject.
      allow update: if isSignedIn() && (
        (isOwnTrader() && request.resource.data.status == resource.data.status)
        || isCustoms()
      );

      allow delete: if false;
    }

    // The public Contact page must work for signed-out visitors, so writes
    // are open but validated; there's no admin UI to read these yet, so
    // reads/updates/deletes are locked down to the Firebase Console.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.message is string && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }
  }
}
